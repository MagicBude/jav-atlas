{
  "name": "jav-atlas-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "dev": "npm run data && vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run data && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "labels:normalize": "node scripts/normalize-tag-labels.mjs",
    "labels:check": "node scripts/normalize-tag-labels.mjs --check"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "opencc-js": "1.4.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
